# 本地开发配置（复制为 .env）。生产配置见 docs/DEPLOYMENT.md 附录 A。
# 数值只接受正整数，布尔值只接受 true/false，其他值启动时报错。
NODE_ENV=development
HOST=127.0.0.1
PORT=3230
PUBLIC_ORIGIN=http://127.0.0.1:3230
DATA_DIR=.work/data
PUBLIC_DIR=public
COOKIE_SECURE=false
TRUST_PROXY=false
# 前端开发服务器不走代理、直接跨端口访问时填写，例如 http://localhost:5173
ALLOWED_ORIGINS=
SESSION_TTL_DAYS=30
DEFAULT_TIMEZONE=Asia/Shanghai
REVIEW_SCHEDULE_DAYS=3,14,60
FREEZE_HOURS=24
TRASH_DAYS=30
AUDIT_RETENTION_DAYS=365
MCP_RATE_PER_MIN=120
MCP_RECORD_PER_HOUR=30
OAUTH_CLIENT_ID_HOSTS=claude.ai,claude.com,chatgpt.com
OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com
OAUTH_ALLOW_LOOPBACK_REDIRECT=false
OAUTH_ACCESS_TTL_MIN=60
OAUTH_REFRESH_TTL_DAYS=60
API_DOCS=true
SPA_FALLBACK=true
LOG_LEVEL=info
