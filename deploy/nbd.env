NODE_ENV=production
HOST=127.0.0.1
PORT=3230
PUBLIC_ORIGIN=https://nbd.dkz12345.com
DATA_DIR=/var/lib/nbd
PUBLIC_DIR=/opt/apps/nbd/frontend
COOKIE_SECURE=true
TRUST_PROXY=true
DEFAULT_TIMEZONE=Asia/Shanghai
FREEZE_HOURS=24
TRASH_DAYS=30
AUDIT_RETENTION_DAYS=365
MCP_RATE_PER_MIN=120
MCP_RECORD_PER_HOUR=30
OAUTH_CLIENT_ID_HOSTS=claude.ai,claude.com,chatgpt.com
OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com
OAUTH_ALLOW_LOOPBACK_REDIRECT=false
API_DOCS=false
# Shared dkz12345 Clerk sign-in (public values). OWNER_CLERK_USER_ID comes from
# the server-only /etc/nbd.local.env, appended by install.sh.
CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZGt6MTIzNDUuY29tJA
CLERK_JWT_KEY_FILE=/etc/nbd-clerk-jwt.pem
SPA_FALLBACK=true
LOG_LEVEL=info
