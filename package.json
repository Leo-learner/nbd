{
  "name": "nbd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts test/security/*.test.ts test/runtime/*.test.ts test/ops/*.test.ts",
    "check": "npm run build && npm run typecheck && npm run frontend:typecheck && npm run frontend:build && npm test",
    "start": "node dist/src/server.js",
    "admin": "node --import tsx scripts/admin.ts",
    "migrate": "node --import tsx scripts/admin.ts migrate",
    "seed": "node --import tsx scripts/seed.ts",
    "contract": "node --import tsx scripts/generate-contract.ts",
    "frontend:dev": "vite --config frontend/vite.config.ts frontend",
    "frontend:build": "vite build --config frontend/vite.config.ts frontend",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@clerk/backend": "3.22.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
